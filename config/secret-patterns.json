{
  "version": "1.0.0",
  "description": "自定义敏感信息正则匹配规则",
  "patterns": [
    {
      "id": "CUSTOM-API-KEY-001",
      "description": "检测自定义 API Key 格式",
      "regex": "(?i)(api[_-]?key|apikey|secret[_-]?key)\\s*[:=]\\s*['\"][A-Za-z0-9_\\-]{20,}['\"]",
      "severity": "high",
      "tags": ["secret", "api-key"]
    },
    {
      "id": "CUSTOM-TOKEN-001",
      "description": "检测 Bearer Token",
      "regex": "Bearer\\s+[A-Za-z0-9_\\-\\.=]{20,}",
      "severity": "high",
      "tags": ["secret", "token"]
    },
    {
      "id": "CUSTOM-PRIVATE-KEY-001",
      "description": "检测私钥文件内容",
      "regex": "-----BEGIN (RSA |DSA |EC |OPENSSH |PGP |)PRIVATE KEY-----",
      "severity": "critical",
      "tags": ["secret", "private-key"]
    },
    {
      "id": "CUSTOM-PASSWORD-001",
      "description": "检测硬编码密码",
      "regex": "(?i)(password|passwd|pwd)\\s*[:=]\\s*['\"][^'\"]{6,}['\"]",
      "severity": "high",
      "tags": ["secret", "password"]
    },
    {
      "id": "CUSTOM-AWS-001",
      "description": "检测 AWS Access Key",
      "regex": "AKIA[0-9A-Z]{16}",
      "severity": "critical",
      "tags": ["secret", "aws"]
    },
    {
      "id": "CUSTOM-GCP-001",
      "description": "检测 GCP Service Account Key",
      "regex": "\"type\"\\s*:\\s*\"service_account\"",
      "severity": "critical",
      "tags": ["secret", "gcp"]
    },
    {
      "id": "CUSTOM-GITHUB-001",
      "description": "检测 GitHub Personal Access Token",
      "regex": "gh[pousr]_[A-Za-z0-9]{36,}",
      "severity": "critical",
      "tags": ["secret", "github"]
    },
    {
      "id": "CUSTOM-JWT-001",
      "description": "检测 JWT Token",
      "regex": "eyJ[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+\\.[A-Za-z0-9_\\-]+",
      "severity": "medium",
      "tags": ["secret", "jwt"]
    },
    {
      "id": "CUSTOM-WEBHOOK-001",
      "description": "检测 Webhook URL",
      "regex": "https://hooks\\.(slack|discord|teams|github)\\.com/[A-Za-z0-9_\\-/]+",
      "severity": "high",
      "tags": ["secret", "webhook"]
    },
    {
      "id": "CUSTOM-DB-URL-001",
      "description": "检测数据库连接字符串（带密码）",
      "regex": "(?i)(mysql|postgres|postgresql|mongodb|redis|mssql)://[A-Za-z0-9_\\-]+:[A-Za-z0-9_\\-]+@",
      "severity": "critical",
      "tags": ["secret", "database"]
    }
  ],
  "allowlist": {
    "files": [
      "\\.example$",
      "\\.sample$",
      "\\.template$",
      ".*test.*\\.(js|ts|py|go|java)",
      ".*spec.*\\.(js|ts|py|go|java)",
      "README\\.md$",
      "CHANGELOG\\.md$"
    ],
    "strings": [
      "your-api-key-here",
      "replace-this-token",
      "xxxxxxxxxxxx",
      "changeme",
      "example.com",
      "localhost"
    ]
  }
}
